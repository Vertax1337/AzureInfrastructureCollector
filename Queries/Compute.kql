Resources
| where type in~ (
    'microsoft.compute/virtualmachines',
    'microsoft.compute/disks',
    'microsoft.compute/availabilitysets'
)
| project
    id,
    name,
    type,
    resourceGroup,
    subscriptionId,
    location,
    tags,
    zones,
    skuName = tostring(sku.name),
    skuTier = tostring(sku.tier),
    vmSize = tostring(properties.hardwareProfile.vmSize),
    vmPowerState = tostring(properties.extended.instanceView.powerState.code),
    vmProvisioningState = tostring(properties.provisioningState),
    vmAvailabilitySetId = tostring(properties.availabilitySet.id),
    vmImageReferenceId = tostring(properties.storageProfile.imageReference.id),
    vmImageSharedGalleryImageId = tostring(properties.storageProfile.imageReference.sharedGalleryImageId),
    vmImageCommunityGalleryImageId = tostring(properties.storageProfile.imageReference.communityGalleryImageId),
    vmImagePublisher = tostring(properties.storageProfile.imageReference.publisher),
    vmImageOffer = tostring(properties.storageProfile.imageReference.offer),
    vmImageSku = tostring(properties.storageProfile.imageReference.sku),
    vmImageVersion = tostring(properties.storageProfile.imageReference.version),
    vmOsDiskName = tostring(properties.storageProfile.osDisk.name),
    vmOsDiskOsType = tostring(properties.storageProfile.osDisk.osType),
    vmOsDiskCaching = tostring(properties.storageProfile.osDisk.caching),
    vmOsDiskCreateOption = tostring(properties.storageProfile.osDisk.createOption),
    vmOsDiskManagedDiskId = tostring(properties.storageProfile.osDisk.managedDisk.id),
    vmOsDiskStorageAccountType = tostring(properties.storageProfile.osDisk.managedDisk.storageAccountType),
    vmOsDiskSizeGB = properties.storageProfile.osDisk.diskSizeGB,
    vmNetworkInterfaces = properties.networkProfile.networkInterfaces,
    vmDataDisks = properties.storageProfile.dataDisks,
    diskManagedBy = tostring(managedBy),
    diskSizeGB = properties.diskSizeGB,
    diskOsType = tostring(properties.osType),
    diskState = tostring(properties.diskState),
    diskTier = tostring(properties.tier),
    diskCreateOption = tostring(properties.creationData.createOption),
    availabilitySetFaultDomainCount = properties.platformFaultDomainCount,
    availabilitySetUpdateDomainCount = properties.platformUpdateDomainCount,
    availabilitySetVirtualMachines = properties.virtualMachines,
    availabilitySetProximityPlacementGroupId = tostring(properties.proximityPlacementGroup.id)
| order by subscriptionId asc, type asc, resourceGroup asc, name asc, id asc
