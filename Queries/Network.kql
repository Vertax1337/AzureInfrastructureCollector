Resources
| where type in~ (
    'microsoft.network/virtualnetworks',
    'microsoft.network/networkinterfaces',
    'microsoft.network/networksecuritygroups',
    'microsoft.network/publicipaddresses',
    'microsoft.network/routetables',
    'microsoft.network/virtualnetworkgateways',
    'microsoft.network/localnetworkgateways',
    'microsoft.network/connections',
    'microsoft.network/networkwatchers'
)
| project
    id,
    name,
    type,
    resourceGroup,
    subscriptionId,
    location,
    tags,
    skuName = iff(type =~ 'microsoft.network/virtualnetworkgateways', tostring(properties.sku.name), tostring(sku.name)),
    skuTier = iff(type =~ 'microsoft.network/virtualnetworkgateways', tostring(properties.sku.tier), tostring(sku.tier)),
    vnetAddressPrefixes = properties.addressSpace.addressPrefixes,
    vnetDnsServers = properties.dhcpOptions.dnsServers,
    vnetEnableDdosProtection = properties.enableDdosProtection,
    vnetDdosProtectionPlanId = tostring(properties.ddosProtectionPlan.id),
    vnetSubnets = properties.subnets,
    vnetPeerings = properties.virtualNetworkPeerings,
    nicNetworkSecurityGroupId = tostring(properties.networkSecurityGroup.id),
    nicEnableAcceleratedNetworking = properties.enableAcceleratedNetworking,
    nicEnableIpForwarding = properties.enableIPForwarding,
    nicMacAddress = tostring(properties.macAddress),
    nicDnsServers = properties.dnsSettings.dnsServers,
    nicVirtualMachineId = tostring(properties.virtualMachine.id),
    nicIpConfigurations = properties.ipConfigurations,
    nsgFlushConnection = properties.flushConnection,
    nsgSecurityRules = properties.securityRules,
    publicIpAddress = tostring(properties.ipAddress),
    publicIpAllocationMethod = tostring(properties.publicIPAllocationMethod),
    publicIpAddressVersion = tostring(properties.publicIPAddressVersion),
    publicIpIdleTimeoutMinutes = properties.idleTimeoutInMinutes,
    publicIpDnsFqdn = tostring(properties.dnsSettings.fqdn),
    routeTableDisableBgpRoutePropagation = properties.disableBgpRoutePropagation,
    routeTableRoutes = properties.routes,
    gatewayType = tostring(properties.gatewayType),
    gatewayVpnType = tostring(properties.vpnType),
    gatewayEnableBgp = properties.enableBgp,
    gatewayActiveActive = properties.activeActive,
    gatewayIpConfigurations = properties.ipConfigurations,
    gatewayBgpAsn = properties.bgpSettings.asn,
    gatewayBgpPeeringAddress = tostring(properties.bgpSettings.bgpPeeringAddress),
    localGatewayIpAddress = tostring(properties.gatewayIpAddress),
    localGatewayAddressPrefixes = properties.localNetworkAddressSpace.addressPrefixes,
    localGatewayBgpAsn = properties.bgpSettings.asn,
    localGatewayBgpPeerWeight = properties.bgpSettings.peerWeight,
    localGatewayBgpPeeringAddress = tostring(properties.bgpSettings.bgpPeeringAddress),
    connectionType = tostring(properties.connectionType),
    connectionProtocol = tostring(properties.connectionProtocol),
    connectionEnableBgp = properties.enableBgp,
    connectionRoutingWeight = properties.routingWeight,
    connectionUsePolicyBasedTrafficSelectors = properties.usePolicyBasedTrafficSelectors,
    connectionDpdTimeoutSeconds = properties.dpdTimeoutSeconds,
    connectionVirtualNetworkGateway1Id = tostring(properties.virtualNetworkGateway1.id),
    connectionVirtualNetworkGateway2Id = tostring(properties.virtualNetworkGateway2.id),
    connectionLocalNetworkGateway2Id = tostring(properties.localNetworkGateway2.id)
| order by subscriptionId asc, type asc, resourceGroup asc, name asc, id asc
