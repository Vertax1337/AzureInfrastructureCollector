{
  "collector": {
    "name": "AzureInfrastructureCollector",
    "version": "0.1.0",
    "schemaVersion": "1.0"
  },
  "requirements": {
    "minimumPowerShellVersion": "7.6.0",
    "requiredModules": [
      "Az.Accounts",
      "Az.ResourceGraph"
    ]
  },
  "validation": {
    "requiredPesterVersion": "6.0.1"
  },
  "resourceGraph": {
    "pageSize": 1000
  },
  "export": {
    "jsonDepth": 20
  },
  "security": {
    "sensitivePropertyPattern": "(?i)(secret|password|passwd|token|credential|connectionstring|connection_string|sastoken|accesskey|accountkey|privatekey|clientsecret|apikey)",
    "sensitiveValuePatterns": [
      "(?i)(?:^|[?&])sig=[^&\\s]+(?:&|$)",
      "(?i)(?:AccountKey|SharedAccessSignature)\\s*=\\s*[^;\\s]+",
      "(?i)-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----",
      "(?i)\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b",
      "(?i)\\b(?:password|passwd|clientsecret|api[_-]?key|access[_-]?key|sas[_-]?token)\\s*[:=]\\s*[^\\s;,]+"
    ]
  }
}
